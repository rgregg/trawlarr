{
  "name": "trawlarr",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "tsc --build && pnpm -r --if-present run build:sql && pnpm --filter @trawlarr/web run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json && tsc --noEmit -p packages/web/tsconfig.test.json",
    "test:watch": "vitest",
    "test:cluster": "docker build -t trawlarr-cluster:dev . && vitest run --config vitest.cluster.config.ts --workspace vitest.cluster.workspace.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "audit:licenses": "node scripts/audit-licenses.mjs",
    "bench:scan": "node scripts/bench-scan.mjs",
    "check:refs": "node scripts/check-project-references.mjs",
    "compat:fetch": "node scripts/fetch-plugin-corpus.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0"
  }
}
